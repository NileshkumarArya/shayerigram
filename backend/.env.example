# ─── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/shayarigram

# ─── JWT ─────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Rotate every 90 days. Zero-downtime: set JWT_SECRET_PREV=OLD while JWT_SECRET=NEW, remove after 15min
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
JWT_SECRET_PREV=
JWT_EXPIRE=15d

# ─── App URL (for email links) ────────────────────────────────────────────
APP_URL=http://localhost:5173

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
# Gmail: use App Password from Google Account > Security > 2FA > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=ShayariGram <your_email@gmail.com>

# ─── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Frontend URL (CORS) ─────────────────────────────────────────────────
# Multiple: CLIENT_URL=http://localhost:5173,https://shayarigram.com
CLIENT_URL=http://localhost:5173

# ─── Cross-domain deployment (Vercel + Railway etc.) ─────────────────────
# Set true if frontend and backend are on DIFFERENT domains
# CROSS_DOMAIN=true

# ─── Security ─────────────────────────────────────────────────────────────
# AUTH_COOKIE_NAME=access_token

# ─── Error Monitoring ──────────────────────────────────────────────────────────
SENTRY_DSN=https://your_dsn@o0.ingest.sentry.io/project_id
